{
  "name": "house-rent-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix web install",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "seed:demo": "npm --prefix server run seed -- --demo",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test && npm --prefix web test",
    "test:server": "npm --prefix server test",
    "test:web": "npm --prefix web test"
  },
  "dependencies": {
    "@neon/config": "^1.12.1",
    "@neon/env": "^2.0.1"
  }
}
