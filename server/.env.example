NODE_ENV=development
PORT=3000
TZ=Africa/Nairobi
# Local PostgreSQL:
DATABASE_URL=postgres://rent:rent@localhost:5432/rent_dev
# Neon (https://neon.tech): copy the connection string from the Neon dashboard, for example
# DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint.REGION.aws.neon.tech/neondb?sslmode=require
# (remove "&channel_binding=require" if Neon adds it; the pg driver does not use it)
JWT_SECRET=Neup+qybqDkVEsZeAxA1qcAVcJPq2PJ2MGVqIa4MjTE=
# Public base URL of the web app (used in the QR code link)
PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# First admin created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Long random string placed in the callback URL path
MPESA_WEBHOOK_SECRET=
# Public HTTPS URL Safaricom can reach (e.g. an ngrok URL in development)
MPESA_CALLBACK_BASE_URL=

# SMS (Africa's Talking). Username "sandbox" uses their sandbox.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=rent@example.com

DISABLE_JOBS=false
